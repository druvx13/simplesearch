{
    "name": "simplesearch/engine",
    "description": "A lightweight search engine with web crawling, FTS5 search, and admin panel",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-curl": "*"
    },
    "autoload": {
        "psr-4": {
            "SimpleSearch\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
